{
    "name": "chansig/directoryindex",
    "description": "A secure, dependency-free directory index distributed as a single PHP file.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ext-xml": "*",
        "ext-xmlwriter": "*",
        "infection/infection": "^0.34",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Chansig\\DirectoryIndex\\": "src/DirectoryIndex/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chansig\\DirectoryIndex\\Tests\\": "tests/Unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "audit": {
            "block-insecure": true
        },
        "sort-packages": true
    }
}
