{
  "$schema": "https://raw.githubusercontent.com/infection/infection/0.34.0/resources/schema.json",
  "source": {
    "directories": ["src/DirectoryIndex"]
  },
  "logs": {
    "text": "build/infection.log",
    "summary": "build/infection-summary.log"
  },
  "mutators": {
    "@default": true
  },
  "testFramework": "phpunit",
  "testFrameworkOptions": "--testsuite=unit,security"
}
